fn mixed_return_int(n: int) -> float:
    value = 1

    if n > 2:
        value = 2.5
    else:
        value = 4

    i = 0

    while i < n:
        i = i + 1
        if i == 2:
            return i
        value = value + 1

    return value

print(mixed_return_int(1))
print(mixed_return_int(4))
