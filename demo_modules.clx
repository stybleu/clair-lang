use base

# Clariox v5 - démonstration

const VERSION = "5.0"
nom = "Alice"
age = 26

print("Clariox {VERSION} - Bonjour {nom}, tu as {age} ans")

# Plage directe
for i in 0..4:
    print("i = {i}")

# Selon / case
couleur = "vert"
match couleur:
    case "rouge":
        print("Stop")
    case "vert":
        print("Passe")
    else:
        print("Couleur inconnue")

# Collections
nombres = [10, 20, 30]
nombres.append(40)
print("Liste :", nombres)

infos = {
    "nom": nom,
    "age": age
}
print("Table :", infos)

# Fonction + typage facultatif
fn double(nombre: int) -> int:
    return nombre * 2

print("Double :", double(21))

# Fichier with fermeture automatique
with fichier = open("clariox_test.txt", "write"):
    fichier.write("Bonjour depuis Clariox")

contenu = read_file("clariox_test.txt")
print("Fichier : {contenu}")

# Erreurs
try:
    error("Erreur volontaire")
catch probleme:
    print("Erreur capturée : {probleme}")
finally:
    print("Toujours exécuté")

# Appartenance with "dans"
if 20 in nombres:
    print("20 est dans la liste")

# break / continue
for j in 0..6:
    if j == 2:
        continue
    if j == 5:
        break
    print("j = {j}")
