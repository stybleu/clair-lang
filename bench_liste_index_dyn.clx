nombres = [10, 20, 30, 40, 50]

somme = 0

clariox_range_index_1 = 0
clariox_range_fin_1 = 100000000
clariox_range_pas_1 = 1
while clariox_range_index_1 < clariox_range_fin_1:
    i = clariox_range_index_1
    somme = somme + nombres[i % 5]

    clariox_range_index_1 = clariox_range_index_1 + clariox_range_pas_1
print(somme)
