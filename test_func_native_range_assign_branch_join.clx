fn range_assign_branch_join(n: int) -> float:
    if n < -100 or n > 100:
        return 0.0
    else:
        value = n
    if value >= 0:
        value = value + 10
    else:
        value = value - 10
    i = 0
    while i < 1:
        value = value + 0.5
        i = i + 1
    return value

print(range_assign_branch_join(-5))
print(range_assign_branch_join(5))
print(range_assign_branch_join(101))
