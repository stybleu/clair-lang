gauche1 = "Al"
droite1 = "ice"
nom = gauche1 + droite1

gauche2 = "A"
droite2 = "lice"
cible = gauche2 + droite2

compteur = 0

clair_range_index_1 = 0
clair_range_fin_1 = 50000000
clair_range_pas_1 = 1
tantque clair_range_index_1 < clair_range_fin_1:
    i = clair_range_index_1
    si nom == cible:
        compteur = compteur + 1

    clair_range_index_1 = clair_range_index_1 + clair_range_pas_1
ecris(compteur)
