fn widen_branch_seed(flag: int, n: int) -> float:
    total = 0
    if flag > 0:
        total = 2
    else:
        total = 3
    i = 0
    while i < n:
        total = total + 0.5
        i = i + 1
    return total

print(widen_branch_seed(1, 0))
print(widen_branch_seed(0, 0))
print(widen_branch_seed(1, 2))
