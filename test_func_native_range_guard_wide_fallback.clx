fn range_guard_wide(n: int) -> float:
    value = 0
    if n >= -9007199254740993 and n <= 9007199254740993:
        value = n
    else:
        return 0.0
    i = 0
    while i < 1:
        value = value + 0.5
        i = i + 1
    return value

print(range_guard_wide(2))
print(range_guard_wide(9007199254740993))
