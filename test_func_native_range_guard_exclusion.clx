fn range_guard_exclusion(n: int) -> float:
    value = 0
    if n < -999999 or n > 999999:
        return 0.0
    else:
        value = n
    i = 0
    while i < 1:
        value = value + 0.5
        i = i + 1
    return value

print(range_guard_exclusion(2))
print(range_guard_exclusion(-2))
print(range_guard_exclusion(1000000))
