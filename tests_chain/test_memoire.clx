a = "Al"
b = "ice"
c = "Alex"
d = "andria"

texte = ""
somme = 0

pour i dans plage(5000000):
    si i % 2 == 0:
        texte = a + b
    sinon:
        texte = c + d

    indice = i % longueur(texte)

    si texte[indice] == "A":
        somme = somme + 1

ecris("Somme :", somme)
ecris("Final :", texte)
