fn range_assign_reverse_sub(n: int) -> float:
    if n < 0 or n > 100:
        return 0.0
    else:
        value = 100 - n
    i = 0
    while i < 1:
        value = value + 0.5
        i = i + 1
    return value

print(range_assign_reverse_sub(0))
print(range_assign_reverse_sub(100))
print(range_assign_reverse_sub(101))
