fn nested_branch_return(n: int) -> float:
    value = 1

    if n > 0:
        if n > 5:
            return 9.5
        else:
            value = 2.5
    else:
        value = 3

    i = 0
    while i < n:
        value = value + 1
        i = i + 1

    return value

print(nested_branch_return(-1))
print(nested_branch_return(2))
print(nested_branch_return(8))
