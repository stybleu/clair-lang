fn triple_loops(n: int) -> int:
    total = 0
    i = 0
    j = 0
    k = 0

    while i < n:
        i = i + 1
        j = 0

        while j < i:
            j = j + 1
            k = 0

            while k < j:
                k = k + 1
                total = total + 1

    return total

print(triple_loops(3))
