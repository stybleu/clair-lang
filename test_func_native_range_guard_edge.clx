fn range_guard_edge(n: int) -> float:
    value = 0
    if n >= -9007199254740992 and n <= 9007199254740992:
        value = n
    else:
        return 0.0
    i = 0
    while i < 0:
        value = value + 0.5
        i = i + 1
    return value

print(range_guard_edge(9007199254740992))
print(range_guard_edge(-9007199254740992))
