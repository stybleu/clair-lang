fn branch_return_after_while(n: int) -> float:
    value = 1
    i = 0

    while i < n:
        value = value + 1
        i = i + 1

    if value > 4:
        return value + 0.5
    else:
        value = value + 2

    return value

print(branch_return_after_while(1))
print(branch_return_after_while(5))
