fn mixed_early(n: int) -> float:
    value = 1

    if n > 5:
        value = 2.5
    else:
        value = 3

    i = 0

    while i < n:
        i = i + 1
        if i == 2:
            return value + i
        value = value + 1

    return value

print(mixed_early(1))
print(mixed_early(3))
print(mixed_early(10))
