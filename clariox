#!/data/data/com.termux/files/usr/bin/bash

set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"

if [ $# -lt 1 ]; then
    echo "Clariox - compilateur natif modulaire"
    echo
    echo "Usage :"
    echo "  ./clariox programme.clx"
    echo "  ./clariox programme.clx programme"
    exit 1
fi

ORIGINAL_DIR="$PWD"
SOURCE="$1"

if [[ "$SOURCE" != /* ]]; then
    SOURCE="$ORIGINAL_DIR/$SOURCE"
fi

if [ ! -f "$SOURCE" ]; then
    echo "[Clariox] Fichier introuvable : $SOURCE"
    exit 1
fi

if [ $# -ge 2 ]; then
    OUTPUT="$2"
else
    OUTPUT="$(basename "$SOURCE" .clx)"
fi

if [[ "$OUTPUT" != /* ]]; then
    OUTPUT="$ORIGINAL_DIR/$OUTPUT"
fi

RAW="$ROOT/.clariox_raw_$$.clx"
OPT="$ROOT/.clariox_opt_$$.clx"
FUNC_C="$ROOT/.clariox_func_$$.c"
LIST_C="$ROOT/.clariox_list_$$.c"
STRING_C="$ROOT/.clariox_string_$$.c"
LITERAL_C="$ROOT/.clariox_literal_$$.c"
NATIVE_C="$ROOT/.clariox_native_$$.c"
NATIVE_BIN="$ROOT/.clariox_native_bin_$$"

cleanup() {
    rm -f \
        "$RAW" \
        "$OPT" \
        "$FUNC_C" \
        "$LIST_C" \
        "$STRING_C" \
        "$LITERAL_C" \
        "$NATIVE_C" \
        "$NATIVE_BIN"
}

trap cleanup EXIT

declare -A MODULES_CHARGES

charger_fichier() {
    local fichier="$1"

    while IFS= read -r ligne || [ -n "$ligne" ]; do

        if [[ "$ligne" =~ ^[[:space:]]*use[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*$ ]]; then

            module="${BASH_REMATCH[1]}"
            module_file="$ROOT/modules/$module.clx"

            if [ ! -f "$module_file" ]; then
                echo "[Clariox] Module introuvable : $module"
                exit 1
            fi

            if [ -z "${MODULES_CHARGES[$module]+x}" ]; then
                MODULES_CHARGES[$module]=1
                echo "[Clariox] Module : $module"
                charger_fichier "$module_file"
            fi

        else
            printf '%s\n' "$ligne" >> "$RAW"
        fi

    done < "$fichier"
}

charger_fichier "$SOURCE"

python \
    "$ROOT/outils/optimise_plage.py" \
    "$RAW" \
    "$OPT"

echo "[Clariox] Optimisation plage()"
echo "[Clariox] Génération C"

cd "$ROOT"

"$ROOT/clarioxc" "$OPT" "$OUTPUT"

CFILE="${OUTPUT}.c"

if [ -f "$CFILE" ]; then

    echo "[Clariox] Analyse des fonctions numériques"

    if python \
        "$ROOT/outils/optimise_fonctions_c.py" \
        "$CFILE" \
        "$FUNC_C"; then

        echo "[Clariox] Optimisation des listes homogènes"

        NUMERIC_INPUT="$FUNC_C"

        if python \
            "$ROOT/outils/optimise_listes_c.py" \
            "$FUNC_C" \
            "$LIST_C"; then

            NUMERIC_INPUT="$LIST_C"
        fi

        echo "[Clariox] Optimisation des chaînes"

        if python \
            "$ROOT/outils/optimise_chaines_c.py" \
            "$NUMERIC_INPUT" \
            "$STRING_C"; then

            NUMERIC_INPUT="$STRING_C"
        else
            echo "[Clariox] Optimisation chaînes ignorée"
        fi

        echo "[Clariox] Mise en cache des littéraux"

        if python \
            "$ROOT/outils/optimise_litteraux_c.py" \
            "$NUMERIC_INPUT" \
            "$LITERAL_C"; then

            NUMERIC_INPUT="$LITERAL_C"
        else
            echo "[Clariox] Optimisation littéraux ignorée"
        fi

        echo "[Clariox] Analyse des types natifs"

        NUMERIC_READY=0

        if grep -Eq \
            'nv_uint\(|NV_MEM_UINT64' \
            "$NUMERIC_INPUT"; then

            echo \
                "[Clariox] uint64 détecté : mode numérique exact"

            cp \
                "$NUMERIC_INPUT" \
                "$NATIVE_C"

            NUMERIC_READY=1

        elif python \
            "$ROOT/outils/optimise_numeriques_mixte_c.py" \
            "$NUMERIC_INPUT" \
            "$NATIVE_C"; then

            NUMERIC_READY=1
        fi

        if [ "$NUMERIC_READY" -eq 1 ]; then

            echo "[Clariox] Compilation native -O3"

            if clang \
                -O3 \
                -I "$ROOT" \
                "$NATIVE_C" \
                -lm \
                -o "$NATIVE_BIN"; then

                mv "$NATIVE_C" "$CFILE"
                mv "$NATIVE_BIN" "$OUTPUT"

                chmod +x "$OUTPUT"

                if grep -Eq \
                    'nv_uint\(|NV_MEM_UINT64' \
                    "$CFILE"; then

                    echo \
                        "[Clariox] Optimisation native uint64 sûre appliquée"
                else
                    echo \
                        "[Clariox] Optimisation native appliquée"
                fi
            else
                echo \
                    "[Clariox] Compilation native échouée"
                echo \
                    "[Clariox] Version dynamique conservée"
            fi

        else
            echo \
                "[Clariox] Analyse numérique impossible"
            echo \
                "[Clariox] Version dynamique conservée"
        fi

    else
        echo \
            "[Clariox] Spécialisation fonctions impossible"
        echo \
            "[Clariox] Version dynamique conservée"
    fi
fi

echo "[Clariox] Exécutable : $OUTPUT"
