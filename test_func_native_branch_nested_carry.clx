fn nested_carry(n: int) -> float:
    value = 10
    other = 1

    if n > 0:
        if n > 10:
            value = 20.5
        else:
            other = other + 2
    else:
        value = 5
        other = other + 4

    return value + other

print(nested_carry(20))
print(nested_carry(5))
print(nested_carry(-1))
